<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>MatPhoto</RootNamespace>
    <AssemblyName>MatPhoto</AssemblyName>

    <!-- The UI culture (en, de) chooses the texts; dates are formatted by the app itself. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.1.0" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="SMBLibrary" Version="1.5.7.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MatPhoto.Tests" />
    <EmbeddedResource Include="Resources\Texts\*.json" />
    <!-- the places of the world for the automatic albums (GeoNames, CC BY 4.0: towns of 15,000 people or more), read offline -->
    <EmbeddedResource Include="Resources\Geo\cities.tsv.gz" />
    <EmbeddedResource Include="Resources\Geo\countries.tsv" />
    <!-- the models of the face recognition (scripts/models.js for a developer; the image downloads them into /app/models) -->
    <None Include="models\*.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
