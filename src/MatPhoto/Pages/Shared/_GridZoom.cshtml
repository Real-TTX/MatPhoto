@* the size of the tiles of the photo grid (photos.js keeps it in the browser): two icons of the header bar *@
<button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-grid-zoom="out" aria-label="@L["Grid.Smaller"]" data-tip="@L["Grid.Smaller"]">@Ui.Icon("zoom-out")</button>
<button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-grid-zoom="in" aria-label="@L["Grid.Larger"]" data-tip="@L["Grid.Larger"]">@Ui.Icon("zoom-in")</button>
